# Optional: override Blender executable discovery
# AI3D_BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# Live-bridge socket (our own addon; 9876 is taken by third-party blender-mcp)
# AI3D_BRIDGE_HOST=127.0.0.1
# AI3D_BRIDGE_PORT=9877

# Backend selection: daemon (default, persistent Blender) | headless (one-shot per batch)
# AI3D_BACKEND=daemon

# Allow the guarded python.exec bridge command (dangerous; off by default)
# AI3D_ALLOW_PYTHON_EXEC=0

# No AI API keys are required: the default provider is "agent-in-loop".
# Reserved for a future ApiModelProvider:
# ANTHROPIC_API_KEY=
