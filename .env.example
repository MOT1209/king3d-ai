# Optional: override Blender executable discovery
# KING3D_BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# Live-bridge socket (our own addon; 9876 is taken by third-party blender-mcp)
# KING3D_BRIDGE_HOST=127.0.0.1
# KING3D_BRIDGE_PORT=9877

# Backend selection: daemon (default, persistent Blender) | headless (one-shot per batch)
# KING3D_BACKEND=daemon

# Allow the guarded python.exec bridge command (dangerous; off by default)
# KING3D_ALLOW_PYTHON_EXEC=0

# No AI API key is required: by default the agent driving the session answers.
# To let the dashboard's editor ask a model directly (docs/ai.md), pick ONE:
#
# Claude (official SDK; the key can also come from ANTHROPIC_API_KEY or `ant auth login`):
# KING3D_LLM_PROVIDER=anthropic
# KING3D_LLM_MODEL=claude-opus-5-5
# KING3D_LLM_API_KEY=
#
# Any OpenAI-compatible server (OpenAI, OpenRouter, Gemini, Ollama, LM Studio, ...):
# KING3D_LLM_PROVIDER=openai-compatible
# KING3D_LLM_BASE_URL=http://127.0.0.1:11434/v1   # Ollama; no key needed
# KING3D_LLM_MODEL=llama3.2
# KING3D_LLM_API_KEY=
